<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="MechanicaLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Palette -->
            <Color x:Key="Accent">#4CAF50</Color>
            <Color x:Key="AccentLight">#81C784</Color>
            <Color x:Key="AccentDark">#2E7D32</Color>
            <Color x:Key="Teal">#26A69A</Color>
            <Color x:Key="Kill">#EF5350</Color>
            <Color x:Key="KillDark">#C62828</Color>
            <Color x:Key="Text100">#FFFFFFFF</Color>
            <Color x:Key="Text70">#B3FFFFFF</Color>
            <Color x:Key="Text40">#66FFFFFF</Color>
            <Color x:Key="Text20">#33FFFFFF</Color>
            <Color x:Key="Surface1">#0DFFFFFF</Color>
            <Color x:Key="Surface2">#1AFFFFFF</Color>
            <Color x:Key="Surface3">#26FFFFFF</Color>
            <Color x:Key="Surface4">#33FFFFFF</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}" />
            <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource Text70}" />
            <SolidColorBrush x:Key="DimBrush" Color="{StaticResource Text40}" />
            <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource Text20}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource Surface3}" />

            <CornerRadius x:Key="R6">6</CornerRadius>
            <CornerRadius x:Key="R10">10</CornerRadius>
            <CornerRadius x:Key="R14">14</CornerRadius>
            <Thickness x:Key="PagePadding">40,32,40,32</Thickness>

            <!-- PLAY button -->
            <Style x:Key="PlayButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="{StaticResource R14}" />
                <Setter Property="Padding" Value="48,16" />
                <Setter Property="MinWidth" Value="240" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Accent}" Offset="0" />
                            <GradientStop Color="{StaticResource Teal}" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card -->
            <Style x:Key="CardPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource R10}" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="BorderBrush" Value="{StaticResource FaintBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="CardPanelWide" TargetType="Border" BasedOn="{StaticResource CardPanel}">
                <Setter Property="Padding" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- Headers -->
            <Style x:Key="PageHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,24" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                <Setter Property="Margin" Value="0,8,0,10" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Height" Value="16" />
            </Style>

            <!-- Badge -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="{StaticResource R6}" />
            </Style>

            <Style x:Key="AccentSmallButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource Accent}" Offset="0" />
                            <GradientStop Color="{StaticResource Teal}" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="IconBox" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource R10}" />
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
