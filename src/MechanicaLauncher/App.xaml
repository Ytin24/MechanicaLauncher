<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="MechanicaLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="AccentGreen">#4CAF50</Color>
            <Color x:Key="AccentGreenHover">#66BB6A</Color>
            <Color x:Key="AccentGreenPress">#388E3C</Color>
            <Color x:Key="SubtleText">#99FFFFFF</Color>
            <Color x:Key="DimText">#66FFFFFF</Color>
            <Color x:Key="CardBg">#1AFFFFFF</Color>
            <Color x:Key="CardBgHover">#26FFFFFF</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentGreen}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentGreenHover}" />
            <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleText}" />
            <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimText}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBg}" />

            <CornerRadius x:Key="SmallRadius">6</CornerRadius>
            <CornerRadius x:Key="MediumRadius">10</CornerRadius>
            <CornerRadius x:Key="LargeRadius">16</CornerRadius>
            <Thickness x:Key="PagePadding">36,28,36,28</Thickness>

            <Style x:Key="PlayButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="{StaticResource MediumRadius}" />
                <Setter Property="Padding" Value="56,16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CardPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource MediumRadius}" />
                <Setter Property="Padding" Value="20,16" />
            </Style>

            <Style x:Key="CardPanelWide" TargetType="Border" BasedOn="{StaticResource CardPanel}">
                <Setter Property="Padding" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="PageHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                <Setter Property="Margin" Value="0,8,0,10" />
                <Setter Property="CharacterSpacing" Value="60" />
            </Style>

            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
            </Style>

            <Style x:Key="AccentSmallButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
