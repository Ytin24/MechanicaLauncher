<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="MechanicaLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="LauncherBackgroundColor">#1B211D</Color>
                    <Color x:Key="LauncherPaneColor">#171D19</Color>
                    <Color x:Key="LauncherCardColor">#252E28</Color>
                    <Color x:Key="LauncherCardHoverColor">#303C33</Color>
                    <Color x:Key="LauncherBorderColor">#435147</Color>
                    <Color x:Key="LauncherSelectionColor">#314F3A</Color>
                    <Color x:Key="LauncherSelectionTextColor">#C5E5CD</Color>
                    <Color x:Key="LauncherActionColor">#347849</Color>
                    <Color x:Key="LauncherActionHoverColor">#3C8753</Color>
                    <Color x:Key="LauncherActionPressedColor">#2C673E</Color>
                    <Color x:Key="LauncherActionTextColor">#FFFFFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="LauncherBackgroundColor">#CFD6D0</Color>
                    <Color x:Key="LauncherPaneColor">#C2CCC4</Color>
                    <Color x:Key="LauncherCardColor">#E0E6E0</Color>
                    <Color x:Key="LauncherCardHoverColor">#D5DFD6</Color>
                    <Color x:Key="LauncherBorderColor">#AFBEB2</Color>
                    <Color x:Key="LauncherSelectionColor">#C8DDCC</Color>
                    <Color x:Key="LauncherSelectionTextColor">#244F30</Color>
                    <Color x:Key="LauncherActionColor">#347849</Color>
                    <Color x:Key="LauncherActionHoverColor">#2E6C41</Color>
                    <Color x:Key="LauncherActionPressedColor">#285D38</Color>
                    <Color x:Key="LauncherActionTextColor">#FFFFFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="LauncherBackgroundColor">{ThemeResource SystemColorWindowColor}</Color>
                    <Color x:Key="LauncherPaneColor">{ThemeResource SystemColorWindowColor}</Color>
                    <Color x:Key="LauncherCardColor">{ThemeResource SystemColorButtonFaceColor}</Color>
                    <Color x:Key="LauncherCardHoverColor">{ThemeResource SystemColorHighlightColor}</Color>
                    <Color x:Key="LauncherBorderColor">{ThemeResource SystemColorWindowTextColor}</Color>
                    <Color x:Key="LauncherSelectionColor">{ThemeResource SystemColorHighlightColor}</Color>
                    <Color x:Key="LauncherSelectionTextColor">{ThemeResource SystemColorHighlightTextColor}</Color>
                    <Color x:Key="LauncherActionColor">{ThemeResource SystemColorHighlightColor}</Color>
                    <Color x:Key="LauncherActionHoverColor">{ThemeResource SystemColorHighlightColor}</Color>
                    <Color x:Key="LauncherActionPressedColor">{ThemeResource SystemColorHighlightColor}</Color>
                    <Color x:Key="LauncherActionTextColor">{ThemeResource SystemColorHighlightTextColor}</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Palette -->
            <Color x:Key="Accent">#4CAF50</Color>
            <Color x:Key="AccentLight">#81C784</Color>
            <Color x:Key="AccentDark">#2E7D32</Color>
            <Color x:Key="Teal">#26A69A</Color>
            <Color x:Key="Kill">#EF5350</Color>
            <Color x:Key="KillDark">#C62828</Color>
            <Color x:Key="Text100">#FFFFFFFF</Color>
            <Color x:Key="Text70">#B3FFFFFF</Color>
            <Color x:Key="Text40">#66FFFFFF</Color>
            <Color x:Key="Text20">#33FFFFFF</Color>
            <Color x:Key="Surface1">#0DFFFFFF</Color>
            <Color x:Key="Surface2">#1AFFFFFF</Color>
            <Color x:Key="Surface3">#26FFFFFF</Color>
            <Color x:Key="Surface4">#33FFFFFF</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="SubtleBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="DimBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="FaintBrush" Color="{ThemeResource TextFillColorDisabled}" />
            <SolidColorBrush x:Key="LauncherBackgroundBrush" Color="{ThemeResource LauncherBackgroundColor}" />
            <SolidColorBrush x:Key="LauncherPaneBrush" Color="{ThemeResource LauncherPaneColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource LauncherCardColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{ThemeResource LauncherCardHoverColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource LauncherBorderColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{ThemeResource LauncherCardColor}" />
            <SolidColorBrush x:Key="PlayBrush" Color="#347849" />
            <SolidColorBrush x:Key="SelectionBrush" Color="{ThemeResource LauncherSelectionColor}" />
            <SolidColorBrush x:Key="SelectionTextBrush" Color="{ThemeResource LauncherSelectionTextColor}" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource LauncherActionColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource LauncherActionHoverColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource LauncherActionPressedColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource LauncherActionTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource LauncherActionTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource LauncherActionTextColor}" />

            <CornerRadius x:Key="R6">6</CornerRadius>
            <CornerRadius x:Key="R10">10</CornerRadius>
            <CornerRadius x:Key="R14">14</CornerRadius>
            <Thickness x:Key="PagePadding">40,32,40,32</Thickness>

            <!-- PLAY button -->
            <Style x:Key="PlayButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="{StaticResource R14}" />
                <Setter Property="Padding" Value="24,16" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource PlayBrush}" />
            </Style>

            <!-- Card -->
            <Style x:Key="CardPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource R10}" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="CardPanelWide" TargetType="Border" BasedOn="{StaticResource CardPanel}">
                <Setter Property="Padding" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- Headers -->
            <Style x:Key="PageHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,24" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                <Setter Property="Margin" Value="0,8,0,10" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Height" Value="16" />
            </Style>

            <!-- Badge -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="{StaticResource R6}" />
            </Style>

            <Style x:Key="AccentSmallButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="IconBox" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource R10}" />
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
