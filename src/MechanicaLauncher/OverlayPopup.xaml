<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MechanicaLauncher.OverlayPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">

    <Grid Background="#EE1A1A2E" Padding="20">
        <StackPanel Spacing="12" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="" FontSize="16" FontWeight="Bold"
                       Foreground="White" TextWrapping="Wrap" />
            <TextBlock x:Name="DescText" Text="" FontSize="13"
                       Foreground="#BBBBBB" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="YesBtn" Content="Да" Click="Yes_Click"
                        MinWidth="80" MinHeight="32" CornerRadius="6"
                        Background="#4CAF50" Foreground="White" />
                <Button x:Name="NoBtn" Content="Нет" Click="No_Click"
                        MinWidth="80" MinHeight="32" CornerRadius="6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
