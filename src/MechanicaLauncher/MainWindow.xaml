<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MechanicaLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mechanica Launcher">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="NavView_SelectionChanged"
            IsSettingsVisible="False"
            CompactPaneLength="48"
            OpenPaneLength="200"
            IsPaneToggleButtonVisible="False">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Instances" Tag="Instances">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mods" Tag="Mods">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Account" Tag="Account">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- TLauncher Lockscreen Overlay -->
        <Grid x:Name="TLauncherOverlay" Visibility="Collapsed" Background="#DD000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="520" Spacing="24">

                <!-- Animated title -->
                <TextBlock x:Name="TLTitle" Text=""
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           CharacterSpacing="100"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="TLTitleRotation" Angle="0" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Warning icon -->
                <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="#FF4444"
                          HorizontalAlignment="Center" />

                <!-- Description -->
                <TextBlock x:Name="TLDesc" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                           Foreground="#CCCCCC" TextAlignment="Center" />

                <!-- Threat count -->
                <TextBlock x:Name="TLThreatCount" Text="Найдено: 0 угроз"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#FF6B6B" HorizontalAlignment="Center" />

                <!-- Timer -->
                <TextBlock x:Name="TLTimer" Text="Кнопки разблокируются через 20 сек..."
                           FontSize="12" Foreground="#888888"
                           HorizontalAlignment="Center" />

                <!-- Progress (hidden until cleanup) -->
                <StackPanel x:Name="TLProgress" Visibility="Collapsed" Spacing="6">
                    <ProgressBar x:Name="TLProgressBar" IsIndeterminate="True" Height="4" CornerRadius="2" />
                    <TextBlock x:Name="TLProgressText" Text="" FontSize="12"
                               Foreground="#AAAAAA" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Button x:Name="TLAcceptBtn" Click="TLAccept_Click"
                            IsEnabled="False" MinWidth="200" MinHeight="44"
                            CornerRadius="8" Background="#4CAF50" Foreground="White"
                            FontSize="14" FontWeight="SemiBold"
                            />
                    <Button x:Name="TLDeclineBtn" Click="TLDecline_Click"
                            IsEnabled="False" MinWidth="140" MinHeight="44"
                            CornerRadius="8" FontSize="14"
                            />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
