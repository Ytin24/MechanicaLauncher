<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Version>0.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Mechanica.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Desktop/**/*.cs" />
    <Ordo Include="Desktop/Views/**/*.ordo" />
    <PackageReference Include="Nitidus.Native" Version="0.1.0-local.20260923.1" />
    <PackageReference Include="Ordo.Build" Version="0.1.0-local.20260923.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" PrivateAssets="all" />
    <ProjectReference Include="../MechanicaLauncher.Core/MechanicaLauncher.Core.csproj" />
    <InternalsVisibleTo Include="MechanicaLauncher.Desktop.Tests" />
    <Content Include="Assets/StoreLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Mechanica.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Mechanica.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
