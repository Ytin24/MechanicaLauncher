<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top: Notification -->
        <InfoBar
            x:Name="NotificationBar"
            Title="Mechanica Launcher"
            Message="Ready to play."
            Severity="Success"
            IsOpen="True"
            IsClosable="True"
            Margin="0,0,0,12" />

        <!-- Center: Hero -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="28">

            <!-- Title -->
            <TextBlock
                Text="MECHANICA"
                FontSize="42"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                CharacterSpacing="200"
                Opacity="0.15" />

            <!-- Profile Dropdown -->
            <Border Style="{StaticResource CardPanel}" HorizontalAlignment="Center" MinWidth="320">
                <ComboBox
                    x:Name="ProfileSelector"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Select version..."
                    FontSize="14"
                    BorderThickness="0"
                    Background="Transparent">
                    <ComboBoxItem Content="1.21.11  ·  Fabric 0.18.4" IsSelected="True" />
                    <ComboBoxItem Content="1.21.11  ·  Vanilla" />
                    <ComboBoxItem Content="1.20.4  ·  Fabric 0.15.11" />
                </ComboBox>
            </Border>

            <!-- Play Button -->
            <Button
                x:Name="PlayButton"
                Style="{StaticResource PlayButton}"
                Click="PlayButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="White" />
                    <TextBlock Text="P L A Y" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Progress -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="6" HorizontalAlignment="Center" MinWidth="400">
                <ProgressBar
                    x:Name="DownloadProgress"
                    Maximum="100" Value="0"
                    IsIndeterminate="False"
                    CornerRadius="4" />
                <TextBlock
                    x:Name="ProgressText"
                    Text="Ready"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource SubtleBrush}"
                    FontSize="12" />
            </StackPanel>
        </StackPanel>

        <!-- Bottom: Status Cards -->
        <Grid Grid.Row="2" ColumnDefinitions="*,12,*,12,*" Margin="0,16,0,0">

            <Border Grid.Column="0" Style="{StaticResource CardPanelWide}">
                <Grid ColumnDefinitions="Auto,*">
                    <FontIcon Glyph="&#xEA86;" FontSize="20" Foreground="{StaticResource AccentBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="MODS" Style="{StaticResource SectionHeader}" Margin="0" FontSize="10" />
                        <TextBlock x:Name="ModCountText" Text="0 active" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardPanelWide}">
                <Grid ColumnDefinitions="Auto,*">
                    <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{StaticResource AccentBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ACCOUNT" Style="{StaticResource SectionHeader}" Margin="0" FontSize="10" />
                        <TextBlock x:Name="AccountText" Text="Offline" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardPanelWide}">
                <Grid ColumnDefinitions="Auto,*">
                    <FontIcon Glyph="&#xE7F8;" FontSize="20" Foreground="{StaticResource AccentBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="JAVA" Style="{StaticResource SectionHeader}" Margin="0" FontSize="10" />
                        <TextBlock x:Name="JavaVersionText" Text="Detecting..." FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
