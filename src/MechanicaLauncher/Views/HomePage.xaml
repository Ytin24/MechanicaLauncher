<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="40" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" MinHeight="72" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="NotificationBar"
            Title="Mechanica Launcher"
            Message="Ready to play."
            Severity="Success"
            IsOpen="True"
            IsClosable="True"
            MinHeight="40"
            Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="28">

            <TextBlock
                Text="MECHANICA"
                FontSize="42"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                CharacterSpacing="200"
                Opacity="0.15"
                Height="52" />

            <Border Style="{StaticResource CardPanel}" HorizontalAlignment="Center"
                    MinWidth="320" MaxWidth="420" MinHeight="52">
                <ComboBox
                    x:Name="ProfileSelector"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Select instance..."
                    FontSize="14"
                    MinHeight="36"
                    BorderThickness="0"
                    Background="Transparent"
                    SelectionChanged="ProfileSelector_Changed">
                    <ComboBoxItem Content="1.21.11  ·  Fabric 0.18.4" IsSelected="True" />
                    <ComboBoxItem Content="1.21.11  ·  Vanilla" />
                    <ComboBoxItem Content="1.20.4  ·  Fabric 0.15.11" />
                </ComboBox>
            </Border>

            <Button
                x:Name="PlayButton"
                Style="{StaticResource PlayButton}"
                Click="PlayButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="White" />
                    <TextBlock Text="P L A Y" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="6"
                        HorizontalAlignment="Center" MinWidth="400" MaxWidth="500" MinHeight="40">
                <ProgressBar
                    x:Name="DownloadProgress"
                    Maximum="100" Value="0"
                    IsIndeterminate="False"
                    Height="6"
                    CornerRadius="3" />
                <TextBlock
                    x:Name="ProgressText"
                    Text="Ready"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource SubtleBrush}"
                    FontSize="12"
                    Height="18" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,12,*,12,*" MinHeight="72" Margin="0,16,0,0">

            <Border Grid.Column="0" Style="{StaticResource CardPanelWide}" MinHeight="68">
                <Grid ColumnDefinitions="Auto,*" MinHeight="40">
                    <FontIcon Glyph="&#xEA86;" FontSize="20" Foreground="{StaticResource AccentBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0" Width="20" Height="20" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MODS" FontSize="10" CharacterSpacing="60"
                                   Foreground="{StaticResource SubtleBrush}" Height="14" />
                        <TextBlock x:Name="ModCountText" Text="0 active" FontSize="16"
                                   FontWeight="SemiBold" Height="22" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardPanelWide}" MinHeight="68">
                <Grid ColumnDefinitions="Auto,*" MinHeight="40">
                    <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{StaticResource AccentBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0" Width="20" Height="20" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ACCOUNT" FontSize="10" CharacterSpacing="60"
                                   Foreground="{StaticResource SubtleBrush}" Height="14" />
                        <TextBlock x:Name="AccountText" Text="Offline" FontSize="16"
                                   FontWeight="SemiBold" Height="22" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardPanelWide}" MinHeight="68">
                <Grid ColumnDefinitions="Auto,*" MinHeight="40">
                    <FontIcon Glyph="&#xE7F8;" FontSize="20" Foreground="{StaticResource AccentBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0" Width="20" Height="20" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="JAVA" FontSize="10" CharacterSpacing="60"
                                   Foreground="{StaticResource SubtleBrush}" Height="14" />
                        <TextBlock x:Name="JavaVersionText" Text="Detecting..." FontSize="16"
                                   FontWeight="SemiBold" Height="22" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
