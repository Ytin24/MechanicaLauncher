<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="QuickNavButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="88" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource LauncherCardHoverColor}" />
    </Page.Resources>

    <Grid RowDefinitions="*,Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PlayColumn.Width" Value="0" />
                        <Setter Target="InstancePicker.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PlayButton.(Grid.Column)" Value="0" />
                        <Setter Target="PlayButton.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PlayButton.(Grid.Row)" Value="1" />
                        <Setter Target="PlayButton.MinHeight" Value="56" />
                        <Setter Target="PlayButton.Margin" Value="0,12,0,0" />
                        <Setter Target="ContentPanel.Padding" Value="24,24,24,32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Padding="{StaticResource PagePadding}" Spacing="24"
                        MaxWidth="1120" HorizontalAlignment="Stretch">
                <InfoBar x:Name="NotificationBar" Title="Mechanica"
                         Visibility="{x:Bind NotificationBar.IsOpen, Mode=OneWay}"
                         Severity="Informational" IsOpen="False" IsClosable="True" />

                <TextBlock Text="MECHANICA" FontSize="28" FontWeight="SemiBold" CharacterSpacing="140" />

                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="SelectedInstanceLabel" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                        <Button x:Name="DetailsButton" Grid.Column="1" Style="{StaticResource SmallButton}" Click="Details_Click" />
                    </Grid>
                    <Border x:Name="CoverBorder" Height="160" CornerRadius="12" Visibility="Collapsed">
                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    </Border>

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="PlayColumn" Width="248" />
                        </Grid.ColumnDefinitions>
                        <DropDownButton x:Name="InstancePicker" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind HeroName.Text, Mode=OneWay}"
                                        HorizontalContentAlignment="Stretch" MinHeight="104"
                                        Padding="20,16" CornerRadius="14"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="HeroIconBorder" Width="48" Height="48" CornerRadius="10"
                                        Background="{StaticResource CardHoverBrush}" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Grid x:Name="HeroIconGrid">
                                        <FontIcon x:Name="HeroIconGlyph" Glyph="&#xE74C;" FontSize="22"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="HeroDetails" Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock x:Name="HeroName" FontSize="18" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="InstanceInfo" FontSize="12"
                                               Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="InstancePickerFlyout" Placement="Bottom" />
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button x:Name="PlayButton" Grid.Column="1" MinHeight="104"
                                Style="{StaticResource PlayButton}" Click="PlayButton_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            </Button.Resources>
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>

                        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Grid.ColumnSpan="2"
                                    Visibility="Collapsed" Spacing="8" Margin="0,16,0,0">
                            <ProgressBar x:Name="DownloadProgress" Maximum="100" Value="0"
                                         IsIndeterminate="False" Height="5" CornerRadius="3" />
                            <TextBlock x:Name="ProgressText" Foreground="{StaticResource SubtleBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="RecentScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" Visibility="Collapsed">
                        <StackPanel x:Name="RecentChips" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4" />
                    </ScrollViewer>
                </StackPanel>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Button x:Name="ModsCard" Style="{StaticResource QuickNavButton}" Click="Card_Mods_Click"
                            AutomationProperties.Name="{x:Bind ModsLabel.Text, Mode=OneWay}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Glyph="&#xEA86;" FontSize="20" Foreground="{StaticResource SubtleBrush}" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="ModsLabel" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock x:Name="ModCountText" Text="0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="AccountCard" Grid.Column="1" Style="{StaticResource QuickNavButton}" Click="Card_Account_Click"
                            AutomationProperties.Name="{x:Bind AccountLabel.Text, Mode=OneWay}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{StaticResource SubtleBrush}" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="AccountLabel" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock x:Name="AccountText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="InstancesCard" Grid.Column="2" Style="{StaticResource QuickNavButton}" Click="Card_Instances_Click"
                            AutomationProperties.Name="{x:Bind InstancesLabel.Text, Mode=OneWay}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE74C;" FontSize="20" Foreground="{StaticResource SubtleBrush}" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="InstancesLabel" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock x:Name="InstanceCountText" Text="0" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
                <ComboBox x:Name="ProfileSelector" Visibility="Collapsed" SelectionChanged="ProfileSelector_Changed" />
            </StackPanel>
        </ScrollViewer>

        <!-- Log bar -->
        <Grid Grid.Row="1" Background="{StaticResource LauncherPaneBrush}">
            <Border x:Name="LogBarCollapsed" Height="28" Tapped="ToggleLog_Click">
                <Grid Padding="16,0" ColumnDefinitions="Auto,*,Auto">
                    <FontIcon Glyph="&#xE756;" FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="LogBarStatus" Text="Game Output" FontSize="11"
                               Foreground="{StaticResource DimBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="10" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid x:Name="LogExpanded" Visibility="Collapsed" RowDefinitions="Auto,*" MaxHeight="220">
                <Border Height="28" Tapped="ToggleLog_Click">
                    <Grid Padding="16,0" ColumnDefinitions="Auto,*,Auto,Auto">
                        <FontIcon Glyph="&#xE756;" FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="LogHeader" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="ClearLog_Click" Padding="4" MinWidth="24" MinHeight="24"
                                CornerRadius="4" Background="Transparent" ToolTipService.ToolTip="Clear">
                            <FontIcon Glyph="&#xE74D;" FontSize="10" />
                        </Button>
                        <FontIcon Grid.Column="3" Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="LogScroll" Padding="16,4,16,8"
                              ViewChanged="LogScroll_ViewChanged">
                    <TextBlock x:Name="LogText" Text="" FontSize="11"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               Foreground="{StaticResource SubtleBrush}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
