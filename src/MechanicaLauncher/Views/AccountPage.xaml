<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="20" Width="500" HorizontalAlignment="Center">
            <TextBlock x:Name="PageTitle" Style="{StaticResource PageHeader}" HorizontalAlignment="Center" />

            <Border x:Name="LoggedInPanel" Style="{StaticResource CardPanelWide}" Padding="32" Visibility="Collapsed" MinHeight="200">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <PersonPicture Width="80" Height="80" HorizontalAlignment="Center" />
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="UsernameText" Text="" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Height="32" />
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4"
                                Padding="10,4" HorizontalAlignment="Center" MinHeight="24">
                            <TextBlock x:Name="AccountBadge" Text="" FontSize="11"
                                       Foreground="White" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <Button x:Name="SignOutBtn" Click="SignOut_Click"
                            Style="{StaticResource SmallButton}" HorizontalAlignment="Center"
                            Foreground="#FF6B6B" MinWidth="100" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="LoginPanel" Spacing="20">
                <Border Style="{StaticResource CardPanelWide}" Padding="24" MinHeight="160">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12" Height="28">
                            <FontIcon Glyph="&#xE8AB;" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="MsTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="MsDesc" Foreground="{StaticResource DimBrush}" FontSize="13"
                                   TextWrapping="Wrap" MinHeight="18" />
                        <Button Style="{StaticResource AccentSmallButton}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" MinHeight="44" Click="MsLogin_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="White" />
                                <TextBlock x:Name="MsSignInText" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto,*" Height="20">
                    <Border Height="1" Background="{StaticResource DimBrush}" VerticalAlignment="Center" Opacity="0.2" />
                    <TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource DimBrush}" Margin="20,0" FontSize="13" />
                    <Border Grid.Column="2" Height="1" Background="{StaticResource DimBrush}" VerticalAlignment="Center" Opacity="0.2" />
                </Grid>

                <Border Style="{StaticResource CardPanelWide}" Padding="24" MinHeight="160">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12" Height="28">
                            <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="{StaticResource SubtleBrush}" />
                            <TextBlock x:Name="OfflineTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="OfflineDesc" Foreground="{StaticResource DimBrush}" FontSize="13"
                                   TextWrapping="Wrap" MinHeight="18" />
                        <Grid ColumnDefinitions="*,Auto" MinHeight="36">
                            <TextBox x:Name="NicknameBox" MinHeight="36" />
                            <Button x:Name="SaveBtn" Grid.Column="1" Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0" MinHeight="36" Click="SaveOffline_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
