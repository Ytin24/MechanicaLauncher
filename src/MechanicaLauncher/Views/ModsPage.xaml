<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent" NavigationCacheMode="Enabled">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <Grid x:Name="HeaderGrid" ColumnDefinitions="*,300" RowDefinitions="Auto,Auto" ColumnSpacing="16" SizeChanged="Header_SizeChanged">
            <StackPanel Spacing="3">
                <TextBlock x:Name="PageTitle" Style="{StaticResource PageHeader}" Margin="0" />
                <TextBlock x:Name="PageSubtitle" Foreground="{StaticResource SubtleBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="InstancePicker" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      SelectionChanged="Instance_Changed" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CatalogTab" Style="{StaticResource FilterChip}" Click="Catalog_Click" />
                <Button x:Name="InstalledTab" Style="{StaticResource FilterChip}" Click="Installed_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckModsButton" Style="{StaticResource SmallButton}" Click="CheckMods_Click" />
                <Button x:Name="OpenFolderBtn" Style="{StaticResource SmallButton}" Click="OpenFolder_Click" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>
                <Button x:Name="RefreshBtn" Style="{StaticResource SmallButton}" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid x:Name="TypeTabs" Grid.Row="2" ColumnSpacing="6" RowSpacing="6" SizeChanged="TypeTabs_SizeChanged" />
        <Grid x:Name="BrowsePanel" Grid.Row="3" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,180" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                <AutoSuggestBox x:Name="ModSearchBox" QueryIcon="Find" MinHeight="36"
                                TextChanged="ModSearch_TextChanged" QuerySubmitted="ModSearch_QuerySubmitted" />
                <ComboBox x:Name="SortFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Tag="relevance" />
                    <ComboBoxItem Tag="downloads" />
                    <ComboBoxItem Tag="newest" />
                    <ComboBoxItem Tag="updated" />
                </ComboBox>
                <CheckBox x:Name="CompatibleOnly" Grid.Row="1" IsChecked="True" Checked="Compatibility_Changed" Unchecked="Compatibility_Changed" />
                <ComboBox x:Name="CategoryFilter" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
            </Grid>
            <TextBlock x:Name="ResultsInfo" Grid.Row="1" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
            <ScrollViewer x:Name="ResultsScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="SearchResultsPanel" Spacing="8" Margin="0,0,4,6" />
            </ScrollViewer>
        </Grid>
        <Grid x:Name="InstalledPanel" Grid.Row="3" RowDefinitions="Auto,Auto,*" RowSpacing="10" Visibility="Collapsed">
            <ComboBox x:Name="WorldPicker" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="World_Changed" />
            <TextBlock x:Name="InstalledInfo" Grid.Row="1" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="InstalledModsPanel" Spacing="8" Margin="0,0,4,6" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
