<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid Padding="{StaticResource PagePadding}" ColumnDefinitions="5*,16,7*" RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Mods" Style="{StaticResource PageHeader}" Margin="0" />
                <TextBlock x:Name="InstanceLabel" Text="No instance selected"
                           Foreground="{StaticResource DimBrush}" FontSize="12" Height="18" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="OpenFolderBtn" Style="{StaticResource SmallButton}" Click="OpenFolder_Click"
                        ToolTipService.ToolTip="Open mods folder">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource SmallButton}" Click="RefreshMods_Click"
                        ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Left: Installed Mods -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*" MinHeight="300">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Text="INSTALLED" Style="{StaticResource SectionHeader}" Margin="0" />
                <TextBlock x:Name="ModCountLabel" Grid.Column="1" Text="0" FontSize="12"
                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel x:Name="InstalledModsPanel" Spacing="6" />
            </ScrollViewer>
        </Grid>

        <!-- Right: Browse Modrinth -->
        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" MinHeight="300">

            <!-- Search -->
            <AutoSuggestBox PlaceholderText="Search mods, shaders, modpacks..." QueryIcon="Find"
                            MinHeight="36" x:Name="ModSearchBox" QuerySubmitted="ModSearch_QuerySubmitted" />

            <!-- Filters -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <ComboBox x:Name="TypeFilter" MinWidth="100" MinHeight="32" SelectedIndex="0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Mods" Tag="mod" />
                    <ComboBoxItem Content="Shaders" Tag="shader" />
                    <ComboBoxItem Content="Resource Packs" Tag="resourcepack" />
                    <ComboBoxItem Content="Modpacks" Tag="modpack" />
                    <ComboBoxItem Content="Datapacks" Tag="datapack" />
                </ComboBox>
                <ComboBox x:Name="SortFilter" MinWidth="110" MinHeight="32" SelectedIndex="0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Relevance" Tag="relevance" />
                    <ComboBoxItem Content="Downloads" Tag="downloads" />
                    <ComboBoxItem Content="Newest" Tag="newest" />
                    <ComboBoxItem Content="Updated" Tag="updated" />
                </ComboBox>
                <ComboBox x:Name="CategoryFilter" MinWidth="110" MinHeight="32" SelectedIndex="0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All" Tag="" />
                    <ComboBoxItem Content="Optimization" Tag="optimization" />
                    <ComboBoxItem Content="Utility" Tag="utility" />
                    <ComboBoxItem Content="Library" Tag="library" />
                    <ComboBoxItem Content="Decoration" Tag="decoration" />
                    <ComboBoxItem Content="Adventure" Tag="adventure" />
                    <ComboBoxItem Content="Technology" Tag="technology" />
                    <ComboBoxItem Content="Magic" Tag="magic" />
                    <ComboBoxItem Content="Storage" Tag="storage" />
                    <ComboBoxItem Content="World Gen" Tag="worldgen" />
                </ComboBox>
            </StackPanel>

            <!-- Results count -->
            <TextBlock Grid.Row="2" x:Name="ResultsInfo" Text="" FontSize="12"
                       Foreground="{StaticResource DimBrush}" Margin="0,8,0,4" Height="18" />

            <!-- Results -->
            <ScrollViewer Grid.Row="3">
                <StackPanel x:Name="SearchResultsPanel" Spacing="6">
                    <Border Style="{StaticResource CardPanelWide}" Opacity="0.5" MinHeight="48">
                        <TextBlock Text="Search or browse mods from Modrinth"
                                   Foreground="{StaticResource DimBrush}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
