<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" ColumnDefinitions="*,16,*" RowDefinitions="Auto,*">

        <TextBlock Text="Mods" Style="{StaticResource PageHeader}" Grid.ColumnSpan="3" />

        <!-- Left: Installed -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*,Auto">
            <TextBlock Text="INSTALLED" Style="{StaticResource SectionHeader}" />

            <ScrollViewer Grid.Row="1">
                <StackPanel x:Name="InstalledModsPanel" Spacing="6" />
            </ScrollViewer>

            <!-- Drop zone -->
            <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,12,0,0"
                    BorderBrush="{StaticResource DimBrush}" BorderThickness="1"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop .jar files here" Foreground="{StaticResource DimBrush}" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right: Browse -->
        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">
            <TextBlock Text="BROWSE MODRINTH" Style="{StaticResource SectionHeader}" />

            <AutoSuggestBox Grid.Row="1" PlaceholderText="Search mods..." QueryIcon="Find"
                            Margin="0,0,0,12" x:Name="ModSearchBox" QuerySubmitted="ModSearch_QuerySubmitted" />

            <ScrollViewer Grid.Row="2">
                <StackPanel x:Name="SearchResultsPanel" Spacing="6">
                    <Border Style="{StaticResource CardPanelWide}" Opacity="0.5">
                        <TextBlock Text="Type to search mods on Modrinth..."
                                   Foreground="{StaticResource DimBrush}" FontSize="13"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
