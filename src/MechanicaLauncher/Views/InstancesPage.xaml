<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Instances" Style="{StaticResource PageHeader}" />
            <Button Grid.Column="1" Style="{StaticResource AccentSmallButton}"
                    Click="NewInstance_Click" MinHeight="36" MinWidth="140"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White" />
                    <TextBlock Text="New Instance" FontSize="13" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="InstancesList" Spacing="8" />
        </ScrollViewer>
    </Grid>
</Page>
