<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Versions" Style="{StaticResource PageHeader}" />
            <AutoSuggestBox Grid.Column="1" PlaceholderText="Search..." QueryIcon="Find"
                            MinWidth="220" VerticalAlignment="Top" />
        </Grid>

        <!-- Installed -->
        <TextBlock Grid.Row="1" Text="INSTALLED" Style="{StaticResource SectionHeader}" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="8">

                <!-- Version Card -->
                <Border Style="{StaticResource CardPanelWide}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4">
                        <Border Background="#2D2D2D" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74C;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="1.21.11" FontSize="17" FontWeight="SemiBold" />
                                <Border Background="{StaticResource AccentBrush}" Style="{StaticResource Badge}">
                                    <TextBlock Text="Fabric" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="3 mods  ·  Last played 2h ago" Foreground="{StaticResource DimBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentSmallButton}" Content="Play" />
                            <Button Style="{StaticResource SmallButton}" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardPanelWide}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4">
                        <Border Background="#2D2D2D" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74C;" FontSize="24" Foreground="#888" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="1.20.4" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Vanilla  ·  0 mods" Foreground="{StaticResource DimBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallButton}" Content="Play" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Available Section -->
                <TextBlock Text="AVAILABLE" Style="{StaticResource SectionHeader}" Margin="0,20,0,0" />

                <Border Style="{StaticResource CardPanelWide}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4">
                        <Border Background="#2D2D2D" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74C;" FontSize="24" Foreground="#FF9800" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="1.21.12" FontSize="17" FontWeight="SemiBold" />
                                <Border Background="#FF9800" Style="{StaticResource Badge}">
                                    <TextBlock Text="Latest" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Released March 2026" Foreground="{StaticResource DimBrush}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AccentSmallButton}" Content="Install" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardPanelWide}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4">
                        <Border Background="#2D2D2D" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74C;" FontSize="24" Foreground="#888" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="1.21.10" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Release" Foreground="{StaticResource DimBrush}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="Install" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
