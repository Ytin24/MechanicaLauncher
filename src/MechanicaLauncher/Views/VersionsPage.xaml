<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Versions" Style="{StaticResource PageHeader}" />
            <ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="24" Height="24"
                          IsActive="True" VerticalAlignment="Top" Margin="0,4,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="VersionsList" Spacing="8" />
        </ScrollViewer>
    </Grid>
</Page>
