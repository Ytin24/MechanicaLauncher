<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.ModProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <Button x:Name="BackButton" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Click="Back_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock x:Name="BackLabel" />
                </StackPanel>
            </Button>
            <HyperlinkButton x:Name="WebsiteButton" Grid.Column="1" Content="Modrinth" Click="Website_Click" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Grid Width="64" Height="64" Background="{StaticResource CardBrush}" CornerRadius="12" VerticalAlignment="Top">
                <FontIcon Glyph="&#xE8A5;" FontSize="26" Foreground="{StaticResource SubtleBrush}" />
                <Image x:Name="ProjectIcon" Stretch="Uniform" />
            </Grid>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock x:Name="ProjectTitle" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProjectSummary" FontSize="13" Foreground="{StaticResource SubtleBrush}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProjectMeta" FontSize="12" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <InfoBar x:Name="LoadError" IsOpen="False" IsClosable="False" Severity="Error" />
            <Button x:Name="RetryButton" Grid.Column="1" Visibility="Collapsed" Click="Retry_Click" />
        </Grid>
        <Grid x:Name="BodyGrid" Grid.Row="3" ColumnDefinitions="*,280" RowDefinitions="*,Auto" ColumnSpacing="18" RowSpacing="12"
              SizeChanged="Body_SizeChanged">
            <Grid x:Name="DetailsPanel" RowDefinitions="Auto,*" RowSpacing="10" MinHeight="160">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DescriptionTab" Style="{StaticResource FilterChip}" Click="Description_Click" />
                    <Button x:Name="GalleryTab" Style="{StaticResource FilterChip}" Click="Gallery_Click" />
                    <ProgressRing x:Name="LoadingRing" IsActive="True" Width="20" Height="20" Margin="8,0,0,0" />
                </StackPanel>
                <Border x:Name="DescriptionPanel" Grid.Row="1" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid x:Name="DescriptionHost">
                        <TextBlock x:Name="DescriptionFallback" Margin="20" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" />
                    </Grid>
                </Border>
                <Grid x:Name="GalleryPanel" Grid.Row="1" RowDefinitions="*,Auto,Auto" RowSpacing="10" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <TextBlock x:Name="GalleryMessage" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" />
                            <Image x:Name="GalleryImage" Stretch="Uniform" ImageOpened="GalleryImage_Opened" ImageFailed="GalleryImage_Failed" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Button x:Name="PreviousImage" Click="PreviousImage_Click" Padding="10">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <TextBlock x:Name="GalleryCaption" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                   MaxLines="2" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                        <Button x:Name="NextImage" Grid.Column="2" Click="NextImage_Click" Padding="10">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="GalleryThumbnails" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6" />
                    </ScrollViewer>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="InstallScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <Border Style="{StaticResource CardPanelWide}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="InstallTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock x:Name="PackTarget" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <ComboBox x:Name="TargetPicker" HorizontalAlignment="Stretch" SelectionChanged="Target_Changed" />
                        <TextBlock x:Name="TargetSummary" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                        <ComboBox x:Name="VersionPicker" HorizontalAlignment="Stretch" SelectionChanged="Version_Changed" IsEnabled="False" />
                        <TextBlock x:Name="VersionInfo" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                        <ComboBox x:Name="WorldPicker" HorizontalAlignment="Stretch" SelectionChanged="World_Changed" Visibility="Collapsed" />
                        <TextBlock x:Name="CompatibilityInfo" FontSize="13" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                        <Button x:Name="InstallButton" Style="{StaticResource AccentSmallButton}" HorizontalAlignment="Stretch"
                                MinHeight="40" IsEnabled="False" Click="Install_Click" />
                        <ProgressBar x:Name="InstallProgress" IsIndeterminate="True" Visibility="Collapsed" />
                        <TextBlock x:Name="InstallStatus" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Button x:Name="CancelButton" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="Cancel_Click" />
                        <Button x:Name="DownloadsButton" HorizontalAlignment="Stretch" Click="Downloads_Click" />
                        <Button x:Name="OpenInstanceButton" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OpenInstance_Click" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
