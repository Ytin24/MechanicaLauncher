<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <SolidColorBrush x:Key="SettingsCardBackground" Color="{ThemeResource LauncherCardColor}" />
        <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="{ThemeResource LauncherCardHoverColor}" />
        <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="{ThemeResource LauncherBackgroundColor}" />
        <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="{ThemeResource LauncherBorderColor}" />
        <Style TargetType="tk:SettingsCard">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style TargetType="tk:SettingsExpander">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="6" HorizontalAlignment="Stretch">

            <TextBlock x:Name="PageTitle" Style="{StaticResource PageHeader}" Margin="0,0,0,12" />

            <!-- Appearance -->
            <TextBlock x:Name="AppearanceLabel" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource DimBrush}" Margin="2,12,0,6" />

            <tk:SettingsCard x:Name="ThemeCard" Description="Switch between dark, light, or match system.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeSelector" SelectionChanged="Theme_Changed" MinWidth="160" SelectedIndex="0">
                    <ComboBoxItem x:Name="ThemeDark" Tag="Dark" />
                    <ComboBoxItem x:Name="ThemeLight" Tag="Light" />
                    <ComboBoxItem x:Name="ThemeSystem" Tag="System" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="LangCard" Description="UI language.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF2B7;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="LangSelector" SelectionChanged="Lang_Changed" MinWidth="160" SelectedIndex="0">
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Русский" Tag="ru" />
                </ComboBox>
            </tk:SettingsCard>

            <!-- Launcher -->
            <TextBlock x:Name="LauncherLabel" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource DimBrush}" Margin="2,16,0,6" />

            <tk:SettingsCard x:Name="CloseOnLaunchCard" Description="Hide the launcher window after starting the game.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8BB;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="CloseOnLaunchToggle" Toggled="CloseOnLaunch_Toggled" />
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="ShowSnapshotsCard" Description="Show Minecraft snapshots when creating a new instance.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="ShowSnapshotsToggle" Toggled="ShowSnapshots_Toggled" />
            </tk:SettingsCard>

            <!-- Discord -->
            <TextBlock Text="Discord" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource DimBrush}" Margin="2,16,0,6" />

            <tk:SettingsExpander x:Name="DiscordCard" Header="Discord Rich Presence">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8BD;" />
                </tk:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="DiscordRpcToggle" Toggled="DiscordRpc_Toggled" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Name="DiscordServerCard">
                        <ToggleSwitch x:Name="DiscordServerToggle" Toggled="DiscordSetting_Toggled" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="DiscordDimensionCard">
                        <ToggleSwitch x:Name="DiscordDimensionToggle" Toggled="DiscordSetting_Toggled" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="DiscordAchievementCard">
                        <ToggleSwitch x:Name="DiscordAchievementToggle" Toggled="DiscordSetting_Toggled" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="DiscordModsCard">
                        <ToggleSwitch x:Name="DiscordModsToggle" Toggled="DiscordSetting_Toggled" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,2,0,0">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DiscordStatusText" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="DiscordReconnectButton" Grid.Column="1" Click="DiscordReconnect_Click"
                                Style="{StaticResource SmallButton}" />
                    </Grid>
                    <TextBlock x:Name="DiscordStatusHint" Foreground="{StaticResource SubtleBrush}" FontSize="12" TextWrapping="Wrap" />
                    <Border x:Name="DiscordPreview" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="DiscordPreviewLabel" Foreground="{StaticResource DimBrush}" FontSize="12" />
                            <TextBlock Text="Mechanica Launcher" Foreground="{StaticResource PrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="DiscordDetailsText" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DiscordStateText" Foreground="{StaticResource SubtleBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="DiscordTimeText" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Event Mode -->
            <tk:SettingsCard x:Name="EventCard" Header="Event Mode"
                             Description="A server event is currently controlling launcher features."
                             Visibility="Collapsed">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C1;" Foreground="#FF9800" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="EventInfoText" Foreground="{StaticResource SubtleBrush}" FontSize="12" TextWrapping="Wrap" />
                    <Button x:Name="EventExitBtn" Content="Exit Event Mode" Click="ExitEvent_Click"
                            Style="{StaticResource SmallButton}" Foreground="#FF6B6B" />
                </StackPanel>
            </tk:SettingsCard>

            <!-- About -->
            <TextBlock Text="About" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource DimBrush}" Margin="2,16,0,6" />

            <tk:SettingsExpander Header="Mechanica Launcher">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </tk:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource DimBrush}" FontSize="12" VerticalAlignment="Center" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Update" Description="Check for the latest release on GitHub.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource SubtleBrush}" FontSize="12" VerticalAlignment="Center" />
                            <Button x:Name="UpdateBtn" Style="{StaticResource AccentSmallButton}"
                                    Visibility="Collapsed" Click="Update_Click" MinHeight="32" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
