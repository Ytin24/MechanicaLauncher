<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16" Width="560" HorizontalAlignment="Center">
            <TextBlock Text="Settings" Style="{StaticResource PageHeader}" HorizontalAlignment="Center" />

            <Border Style="{StaticResource CardPanelWide}" Padding="24" MinHeight="100">
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10" Height="28">
                        <FontIcon Glyph="&#xE771;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox Header="Theme" x:Name="ThemeSelector" SelectionChanged="Theme_Changed"
                              MinWidth="200" MinHeight="36" SelectedIndex="0">
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="System" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanelWide}" Padding="24" MinHeight="100">
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10" Height="28">
                        <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Launcher" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleSwitch x:Name="CloseOnLaunchToggle" Header="Close launcher when game starts"
                                  MinHeight="44" Toggled="CloseOnLaunch_Toggled" />
                    <ToggleSwitch x:Name="ShowSnapshotsToggle" Header="Show snapshot versions in instance creation"
                                  MinHeight="44" Toggled="ShowSnapshots_Toggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanelWide}" Padding="20" MinHeight="60">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Mechanica Launcher" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Height="22" />
                    <TextBlock Text="v2.0.0  ·  WinUI 3  ·  .NET 9" Foreground="{StaticResource DimBrush}" FontSize="12" HorizontalAlignment="Center" Height="18" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
