<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicaLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="16" Width="560" HorizontalAlignment="Center">
            <TextBlock x:Name="PageTitle" Style="{StaticResource PageHeader}" HorizontalAlignment="Center" />

            <Border Style="{StaticResource CardPanelWide}" Padding="24" MinHeight="100">
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10" Height="28">
                        <FontIcon Glyph="&#xE771;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="AppearanceLabel" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeSelector" SelectionChanged="Theme_Changed"
                              MinWidth="200" MinHeight="36" SelectedIndex="0">
                        <ComboBoxItem x:Name="ThemeDark" />
                        <ComboBoxItem x:Name="ThemeLight" />
                        <ComboBoxItem x:Name="ThemeSystem" />
                    </ComboBox>

                    <ComboBox x:Name="LangSelector" SelectionChanged="Lang_Changed"
                              MinWidth="200" MinHeight="36" SelectedIndex="0">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Русский" Tag="ru" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanelWide}" Padding="24" MinHeight="100">
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10" Height="28">
                        <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="LauncherLabel" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleSwitch x:Name="CloseOnLaunchToggle" MinHeight="44" Toggled="CloseOnLaunch_Toggled" />
                    <ToggleSwitch x:Name="ShowSnapshotsToggle" MinHeight="44" Toggled="ShowSnapshots_Toggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanelWide}" Padding="24" MinHeight="100">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10" Height="28">
                        <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Mechanica Launcher" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource DimBrush}" FontSize="13" />
                    <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                    <Button x:Name="UpdateBtn" Style="{StaticResource AccentSmallButton}"
                            Visibility="Collapsed" Click="Update_Click" MinHeight="36" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
